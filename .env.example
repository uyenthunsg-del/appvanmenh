# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đưa .env lên git, KHÔNG gửi vào chat.
APP_ENV=local
# 1 = hiện chi tiết lỗi (chỉ dùng khi chạy local), 0 = chỉ hiện thông báo chung
APP_DEBUG=1

# Database (MariaDB trong FlyEnv). Kiểm tra cổng trong mục MariaDB của FlyEnv, thường là 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tuvi
DB_USER=tuvi
DB_PASS=3jBCo23XRtIoSGjT

# FastAPI engine (Python). Chỉ lắng nghe trên 127.0.0.1.
ENGINE_URL=http://127.0.0.1:8000
ENGINE_TIMEOUT=10

# Giai đoạn 5 (luận giải AI). Khóa chỉ được đọc ở phía server (PHP), không bao giờ để trong JavaScript.
AI_API_KEY=
